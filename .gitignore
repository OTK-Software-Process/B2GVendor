# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables (keep .env.example tracked)
.env
.env.*
!.env.example
!.env.production.example

# Next.js (B2GVendor)
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Backend build output
dist/
build/

# Downloaded TOR files (runtime data, not source -- see docker-compose's
# tor-storage volume)
Backend/storage/

# Performance-test state: seeded ids, throwaway session cookies, k6/Lighthouse results
Backend/perf/.state/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Testing / coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# Editors
.idea/

# Docker
docker-compose.override.yml

# Production secrets (docker/secrets/generate.sh): one file per secret, never committed
/secrets/

# Misc
*.pem
.turbo/

.claude
.vscode
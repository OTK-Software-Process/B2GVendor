# Host ports for docker-compose (override if any of these are already in use)
FRONTEND_PORT=3000
BACKEND_PORT=4000
MONGO_PORT=27017

# Used as a build arg for the frontend image — see B2GVendor/Dockerfile.
# Point this at the backend's public URL (as reachable from the browser).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ---------------------------------------------------------------------------
# Production only: docker-compose.prod.yml (docs/Deployment.md). Not used by the
# local stack above.
# ---------------------------------------------------------------------------
# The website and the API on DIFFERENT host names, as siblings of one domain (the
# session cookie is SameSite=Lax, which needs the same registrable domain). Both must
# point at this server in DNS before the first start: Let's Encrypt checks it.
# APP_HOST=app.example.com
# API_HOST=api.example.com
# Makes a plain `docker compose` use the production files, so the local (plain HTTP) stack
# can never be started on a server by mistake. (Use ';' instead of ':' on Windows.)
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Where Let's Encrypt may write about a certificate that cannot be renewed.
# ACME_EMAIL=ops@example.com
# Where the secret files are (docker/secrets/generate.sh creates them). Default ./secrets.
# SECRETS_DIR=./secrets
# Host ports of the edge proxy (default 80 and 443; change only to rehearse locally).
# EDGE_HTTP_PORT=80
# EDGE_HTTPS_PORT=443

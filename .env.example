# Host ports for docker-compose (override if any of these are already in use)
FRONTEND_PORT=3000
BACKEND_PORT=4000
MONGO_PORT=27017

# Used as a build arg for the frontend image — see B2GVendor/Dockerfile.
# Point this at the backend's public URL (as reachable from the browser).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

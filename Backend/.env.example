NODE_ENV=development
PORT=4000

# Local dev default points at the docker-compose mongo service.
# In production, point this at your MongoDB Atlas connection string instead.
MONGODB_URI=mongodb://mongo:27017/b2gvendor

# Comma-separated list. Every origin that calls the API with credentials must be
# listed explicitly -- a wildcard is rejected by browsers when cookies are involved.
CORS_ORIGIN=http://localhost:3000

# Where the frontend lives. Used to build verification and reset links in emails.
APP_URL=http://localhost:3000

SESSION_COOKIE_NAME=b2g_session
SESSION_TTL_DAYS=7

# 'lax' works when the frontend and API are the same site (localhost:3000 and
# localhost:4000 in dev, app.example.com and api.example.com in prod).
# Switch to 'none' only if they end up on genuinely different domains -- that
# also forces the cookie to Secure, so it will not work over plain http.
COOKIE_SAMESITE=lax

BCRYPT_ROUNDS=12

# Email delivery for verification and password reset. Leave unset in dev to
# skip sending; the app will still boot.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=B2G Vendor <no-reply@b2gvendor.local>

# --- Data ingestion (N1) ---
# The live source (no API key needed) -- see testAPI/explore-egp-rss.ts for
# how this was verified: deptId + anounceType query params, Windows-874 encoded.
# Each GovSite's deptId (models/govSite.model.ts) is a plain, manually-entered
# value -- confirmed live (2026-09-14) that data.go.th has no equivalent
# deptId/agency-code field in any dataset checked, so this backend cannot
# resolve it automatically. It must come from wherever your team already
# sources e-GP department codes from.
EGP_RSS_BASE_URL=https://process3.gprocurement.go.th/EPROCRssFeedWeb/egpannouncerss.xml

# The historical/enrichment source (CKAN) -- budget/winner facts only, AFTER
# award. Unrelated to deptId/the live RSS feed above; nothing below resolves
# a deptId. Public reads worked without a key in testing -- set one anyway
# from https://opend.data.go.th/register_api/.
DATA_GO_TH_BASE_URL=https://data.go.th
# DATA_GO_TH_API_KEY=

# Per-site resource_id resolution -- resolveDataGoThResourceId()
# (services/dataGoThResource.service.ts) tries these IN ORDER, per GovSite,
# and stops at the first one that resolves:
#   1. GovSite.dataGoThResourceId (set via the admin API/UI, per site) ->
#      a manual pin. When present it ALWAYS wins outright -- steps 2 and 3,
#      and the two DEFAULT_* vars below, are never even looked at for that
#      site.
#   2. GovSite.dataGoThPackageId, or (if that site didn't set one) this
#      shared DATA_GO_TH_DEFAULT_PACKAGE_ID -> package_show is called on it
#      and the current resource inside that ONE package is picked. Fits a
#      dataset published as one stable package holding several dated
#      resources (e.g. cgd_egp_01).
#   3. GovSite.dataGoThSearchQuery, or (if unset) this shared
#      DATA_GO_TH_DEFAULT_SEARCH_QUERY -> package_search finds the newest
#      matching PACKAGE first, then resolves a resource inside THAT one.
#      Needed when the dataset instead publishes one NEW package per period
#      (confirmed true of CGD's own contract data -- see
#      integrations/dataGoTh.client.ts's header comment) -- step 2's fixed
#      package id can't track that kind of rollover by itself.
# If none of the 3 resolve for a site, that site's data.go.th enrichment run
# is skipped (logged, not an error) -- it just has nothing to enrich from yet.
#
# Shared fallback for step 2 -- leave unset if every site pins its own
# dataGoThResourceId or dataGoThPackageId manually.
# DATA_GO_TH_DEFAULT_PACKAGE_ID=
# Shared fallback for step 3. Example query:
# 'organization:cgd title:รายงานการจัดซื้อจัดจ้าง'
# DATA_GO_TH_DEFAULT_SEARCH_QUERY=

# How often (ms) the ingestion-worker container checks for a queued PollJob
# (i.e. someone clicked "Poll Now"). Lower = more responsive, more DB reads.
POLL_JOB_CLAIM_INTERVAL_MS=5000
# Used only for a GovSite that doesn't set its own pollIntervalMinutes.
POLL_DEFAULT_INTERVAL_MINUTES=30
# Local disk path for downloaded TOR PDFs. In docker-compose this should be a
# volume shared between the backend and ingestion-worker containers.
TOR_STORAGE_DIR=storage/tor

# Customer requirement: restrict ingestion to a single topic (e.g.
# "software") across every GovSite uniformly. Off by default. To turn it on:
#   1. Set this to true (also requires AI_TAGGING_ENABLED=true below --
#      without AI, nothing can ever be classified as in-scope).
#   2. Flag the relevant tag(s) via PATCH /admin/tags/:id/ingestion-filter
#      {"value": true} -- e.g. the "software" category tag. A NEW work is
#      only created if the AI's resulting tags include at least one flagged
#      tag; an already-tracked work's later lifecycle updates are never
#      retroactively hidden by this filter.
INGESTION_TOPIC_FILTER_ENABLED=false

# --- AI-assisted tagging (N3) ---
# Master on/off switch, checked BEFORE AI_PROVIDER below:
#   AI_TAGGING_ENABLED=false -> no AI call is ever made, no matter what
#                               AI_PROVIDER or keys are set to. Ingestion
#                               works fine either way -- AI tags/description
#                               are always best-effort, never required.
#   AI_TAGGING_ENABLED=true  -> AI_PROVIDER below picks which backend serves
#                               the call.
AI_TAGGING_ENABLED=false

# Which backend analyzeTorDocument() actually calls -- this is the strategy
# switch, read only when AI_TAGGING_ENABLED=true. Changing it needs no code
# change, just a redeploy/restart. See integrations/ai/index.ts.
#   AI_PROVIDER=openrouter -> uses the "Option A" block below
#                             (OPENROUTER_API_KEY/MODEL/BASE_URL). The
#                             "Option B" Vertex AI vars are read but unused.
#   AI_PROVIDER=vertexai   -> uses the "Option B" block below
#                             (GOOGLE_CLOUD_*/VERTEX_AI_MODEL/
#                             GOOGLE_APPLICATION_CREDENTIALS). The "Option A"
#                             OpenRouter vars are read but unused.
# Any other value is rejected at boot (env.ts validates it against exactly
# these two) -- you only ever need ONE option's vars filled in, matching
# whichever you pick here; leave the other option's blank/commented.
AI_PROVIDER=openrouter

# --- Option A: OpenRouter (https://openrouter.ai) -- only used when
# AI_PROVIDER=openrouter above. One API key, many hosted models -- pick any
# OpenRouter model slug for OPENROUTER_MODEL. If OPENROUTER_API_KEY is left
# unset while this option is selected, analyzeTorDocument() logs a warning
# and quietly returns no tags/description (never throws, never blocks
# ingestion) -- so tagging silently no-ops until you set a real key.
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.5-flash-02-23
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Option B: Vertex AI (Google Cloud) -- only used when
# AI_PROVIDER=vertexai above. Needs a GCP project with the Vertex AI API
# enabled and a service account. If GOOGLE_CLOUD_PROJECT is left unset while
# this option is selected, same as Option A above -- warns and no-ops rather
# than failing ingestion.
# GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
VERTEX_AI_MODEL=gemini-2.0-flash-001
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json

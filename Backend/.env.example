NODE_ENV=development
PORT=4000

# Local dev default points at the docker-compose mongo service.
# In production, point this at your MongoDB Atlas connection string instead.
MONGODB_URI=mongodb://mongo:27017/b2gvendor

# Comma-separated list. Every origin that calls the API with credentials must be
# listed explicitly -- a wildcard is rejected by browsers when cookies are involved.
CORS_ORIGIN=http://localhost:3000

# Where the frontend lives. Used to build verification and reset links in emails.
APP_URL=http://localhost:3000

SESSION_COOKIE_NAME=b2g_session
SESSION_TTL_DAYS=7

# 'lax' works when the frontend and API are the same site (localhost:3000 and
# localhost:4000 in dev, app.example.com and api.example.com in prod).
# Switch to 'none' only if they end up on genuinely different domains -- that
# also forces the cookie to Secure, so it will not work over plain http.
COOKIE_SAMESITE=lax

BCRYPT_ROUNDS=12

# Email delivery for verification and password reset. Leave unset in dev to
# skip sending; the app will still boot.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=B2G Vendor <no-reply@b2gvendor.local>

# --- Data ingestion (N1) ---
# The live source (no API key needed) -- see testAPI/explore-egp-rss.ts for
# how this was verified: deptId + anounceType query params, Windows-874 encoded.
EGP_RSS_BASE_URL=https://process3.gprocurement.go.th/EPROCRssFeedWeb/egpannouncerss.xml

# The historical/enrichment source (CKAN). Public reads worked without a key
# in testing -- set one anyway from https://opend.data.go.th/register_api/.
DATA_GO_TH_BASE_URL=https://data.go.th
# DATA_GO_TH_API_KEY=

# How often (ms) the ingestion-worker container checks for a queued PollJob
# (i.e. someone clicked "Poll Now"). Lower = more responsive, more DB reads.
POLL_JOB_CLAIM_INTERVAL_MS=5000
# Used only for a GovSite that doesn't set its own pollIntervalMinutes.
POLL_DEFAULT_INTERVAL_MINUTES=30
# Local disk path for downloaded TOR PDFs. In docker-compose this should be a
# volume shared between the backend and ingestion-worker containers.
TOR_STORAGE_DIR=storage/tor

# --- AI-assisted tagging (N3, planned: Vertex AI) ---
# Keep false until GOOGLE_APPLICATION_CREDENTIALS points at a real service
# account -- ingestion works fine with this off, AI tags are best-effort only.
AI_TAGGING_ENABLED=false
# GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
VERTEX_AI_MODEL=gemini-2.0-flash-001
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json

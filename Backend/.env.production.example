# Backend settings for a PRODUCTION deployment (docker-compose.prod.yml; docs/Deployment.md).
# Copy to Backend/.env. It holds NO SECRET: the secrets are files in ./secrets, given to
# each service by compose (Docker secrets). The process refuses to start if one of
# MONGODB_URI, SMTP_PASS, OPENROUTER_API_KEY, DATA_GO_TH_API_KEY or MFA_ENCRYPTION_KEY is
# also set here.
#
# Not set here, because compose sets them from APP_HOST / API_HOST in the root .env:
#   NODE_ENV, APP_URL, CORS_ORIGIN, COOKIE_SAMESITE, REQUIRE_SECURE_BACKENDS,
#   MONGODB_URI_FILE, SMTP_PASS_FILE, DATA_GO_TH_API_KEY_FILE, OPENROUTER_API_KEY_FILE,
#   MFA_ENCRYPTION_KEY_FILE, MFA_REQUIRED_FOR_STAFF (always true in production: staff must
#   set up two-step sign-in, and this file cannot turn that off).

PORT=4000

SESSION_COOKIE_NAME=b2g_session
SESSION_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Email. Without SMTP_HOST no mail is sent and sign-up is unavailable (an account cannot
# sign in until its email is verified). In production the connection MUST use TLS: port 587
# (STARTTLS, required) or 465 (TLS from the first byte). The password is the smtp_pass secret.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
MAIL_FROM=B2G Vendor <no-reply@example.com>

# The live source and the open-data portal (both HTTPS).
EGP_RSS_BASE_URL=https://process3.gprocurement.go.th/EPROCRssFeedWeb/egpannouncerss.xml
EGP_HTML_TOR_ENABLED=true
DATA_GO_TH_BASE_URL=https://data.go.th

POLL_JOB_CLAIM_INTERVAL_MS=5000
TOR_STORAGE_DIR=storage/tor

INGESTION_TOPIC_FILTER_ENABLED=false

# AI tagging is optional. The key is the openrouter_api_key secret; the Google service
# account (AI_PROVIDER=vertexai) is the google_credentials secret.
AI_TAGGING_ENABLED=false
AI_PROVIDER=openrouter
OPENROUTER_MODEL=qwen/qwen3.5-flash-02-23
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
VERTEX_AI_MODEL=gemini-2.0-flash-001

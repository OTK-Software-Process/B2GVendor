{
  "name": "b2gvendor-backend",
  "private": true,
  "version": "0.0.1",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "check:shared": "tsx tests/integration/shared-layer.check.ts",
    "check:auth": "tsx tests/integration/auth-flow.check.ts",
    "check:admin-guard": "tsx tests/integration/admin-guard.check.ts",
    "check:admin-dashboard": "tsx tests/integration/admin-dashboard.check.ts",
    "check:admin-tags": "tsx tests/integration/admin-tags.check.ts",
    "check:admin-works": "tsx tests/integration/admin-works.check.ts",
    "check:admin-accounts": "tsx tests/integration/admin-accounts.check.ts",
    "check:admin-staff": "tsx tests/integration/admin-staff.check.ts",
    "check:admin-ingestion": "tsx tests/integration/admin-ingestion.check.ts",
    "check:admin-permissions": "tsx tests/integration/admin-permissions.check.ts",
    "check:ingestion": "tsx tests/integration/ingestion-flow.check.ts",
    "check:price": "tsx tests/integration/price-extraction.check.ts",
    "check:html-tor": "tsx tests/integration/html-tor.check.ts",
    "check:facts": "tsx tests/integration/procurement-facts.check.ts",
    "check:facts-db": "tsx tests/integration/work-facts-db.check.ts",
    "check:facts-ingestion": "tsx tests/integration/ingestion-facts.check.ts",
    "check:poll-control": "tsx tests/integration/poll-control.check.ts",
    "backfill:budgets": "tsx src/scripts/backfillBudgets.ts",
    "backfill:html-prices": "tsx src/scripts/backfillHtmlPrices.ts",
    "backfill:facts": "tsx src/scripts/backfillProcurementFacts.ts",
    "backfill:search-text": "tsx src/scripts/backfillSearchText.ts",
    "check:thai-search": "tsx tests/unit/thai-search.check.ts",
    "seed:admins": "tsx src/scripts/seedAdmin.ts",
    "seed:superadmin": "tsx src/scripts/seedSuperAdmin.ts",
    "seed:gov-sites": "tsx src/scripts/seedGovSites.ts",
    "seed:tags": "tsx src/scripts/seedTags.ts",
    "seed:all": "npm run seed:gov-sites && npm run seed:tags"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.9.3",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^4.5.1",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
